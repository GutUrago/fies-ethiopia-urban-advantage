    given-names: Gutama Girja
    affiliation: Laterite
    email: gurago@laterite.com
license: MIT
repository-code: "https://github.com/GutUrago/fies-ethiopia-urban-advantage"
keywords:
  - food security
  - FIES
  - Ethiopia
  - urban-rural
  - Rasch model
  - survey weights
  - R
